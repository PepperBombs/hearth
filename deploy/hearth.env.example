# Settings and secrets for the Hearth server. Copy to /etc/hearth/hearth.env,
# owned by root, readable by the "hearth" group only (chmod 640).
# Never commit the real file. Every value below is a placeholder.

# The owner's email address: the one person let in without an invitation.
HEARTH_OWNER_EMAIL=you@example.com

# Who may create groups and invite people who are not on this server yet:
# "owner" (you alone, the default) or "everyone" on the server.
# HEARTH_GROUP_POLICY=owner

# Cloudflare Access. The team domain is under Zero Trust > Settings > Custom
# Pages; the audience tag is on the Access application's Overview tab.
HEARTH_AUTH=cloudflare-access
HEARTH_CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
HEARTH_CF_AUDIENCE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Where data lives, outside every repository. DATABASE in deploy.conf must
# name the same file.
HEARTH_DB=/var/lib/hearth/hearth.db

# The owner's content repository, checked out beside the framework. (Which
# mini-apps a release holds is decided when it is built, not here.)
HEARTH_DATA_DIR=/opt/hearth/repos/hearth-data

# Listen on this machine only; the Cloudflare tunnel connects locally.
HOST=127.0.0.1
PORT=4310
