{
  "name": "hearth",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "apps:sync": "node packages/sdk/bin/hearth-apps.mjs sync",
    "dev": "pnpm apps:sync && concurrently -n server,web -c blue,green \"pnpm --filter @hearth/server dev\" \"pnpm --filter @hearth/web dev\"",
    "build": "pnpm apps:sync && pnpm --filter @hearth/shared build && pnpm --filter @hearth/web build && pnpm --filter @hearth/server build",
    "start": "pnpm --filter @hearth/server start",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm -r test && pnpm test:deploy",
    "test:deploy": "bash deploy/tests/deploy.test.sh",
    "e2e": "playwright test --trace off",
    "e2e:mini-apps": "playwright test --config playwright.mini-apps.config.ts --trace off --pass-with-no-tests",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
