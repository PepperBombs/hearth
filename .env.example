# Local development. Copy to .env and export it, or pass these on the command line.
# Sign-in is switched off: every request is treated as HEARTH_DEV_USER.
HEARTH_AUTH=dev
HEARTH_OWNER_EMAIL=you@example.com
# To see what an uninvited person sees:
# HEARTH_DEV_USER=guest@example.com
# To build the framework's sample mini-apps in (read by `pnpm dev` and `pnpm build`,
# not by the running server). A mini-apps checkout beside this one works the same way.
# HEARTH_APPS_DIR=packages/fixture-apps
